{
    "manifest_version": 3,
    "name": "Atıfmatik",

    "version": "2.0",

    "description": "DOI numarasını bulur ve APA atıfını kopyalar.",
    "permissions": [
        "activeTab",
        "clipboardWrite",
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon48.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}